{
  "name": "vorium-ui",
  "version": "0.1.0",
  "main": "./dist/vorium-ui.common.js",
  "exports": {
    ".": {
      "require": "./dist/vorium-ui.common.js",
      "default": "./dist/vorium-ui.common.js"
    },
    "./icons": {
      "require": "./dist/icons/icons.common.js",
      "default": "./dist/icons/icons.common.js"
    },
    "./icons/icons.css": "./dist/icons/icons.css",
    "./dist/vorium-ui.css": "./dist/vorium-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "npm run build:core && npm run build:icons",
    "build:core": "vue-cli-service build --target lib --name vorium-ui --dest dist src/index.js",
    "build:icons": "vue-cli-service build --target lib --name icons --dest dist/icons src/icons/index.js",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "monaco-editor": "^0.49.0"
  },
  "peerDependencies": {
    "vue": "^3.2.13"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "monaco-editor-webpack-plugin": "^7.1.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
